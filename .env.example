# Copy to .env for local development. Never use these demo values in a public deployment.
APP_ENV=development
SECRET_KEY=DEMO_SECRET_KEY_FOR_LOCAL_TESTING
DATABASE_URL=sqlite:///./library_demo.db
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_BASE_URL=http://127.0.0.1:5500
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional password-recovery email through a transactional email API over HTTPS
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Neptruyen

# Leave empty to use local storage during development. Configure these only on the API host.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=digital-library-books
MAX_BOOK_FILE_MB=50
